---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import SignUpFormClient from "../components/scripts/SignUpFormClient.jsx";
import GoogleOAuthClient from "../components/scripts/GoogleOAuthClient.jsx";

const apiBase = import.meta.env.PUBLIC_API_URL || "";
const googleClientId = import.meta.env.GOOGLE_OAUTH_CLIENT_ID || "";
const url = new URL(Astro.request.url);
const redirectParam = url.searchParams.get("redirect") ?? "/app/account";
const redirectEncoded = encodeURIComponent(redirectParam);
const googleRedirectUri = apiBase
  ? `${apiBase.replace(/\/$/, "")}/auth/google_oauth_callback`
  : "";
const googleOAuthUrl = (() => {
  if (!googleClientId || !googleRedirectUri) return "";
  const params = new URLSearchParams({
    client_id: googleClientId,
    redirect_uri: googleRedirectUri,
    response_type: "code",
    scope: "openid email profile",
    access_type: "offline",
    prompt: "consent",
    state: redirectParam,
  });
  return `https://accounts.google.com/o/oauth2/v2/auth?${params.toString()}`;
})();
console.log("Google OAuth URL:", googleOAuthUrl);
const googleButtonBaseClass =
  "w-full inline-flex items-center justify-center gap-3 rounded-lg border border-border bg-white px-4 py-2.5 text-sm font-medium text-[#3c4043] shadow-sm transition hover:bg-[#f7f8f8]";
const googleButtonClass = `${googleButtonBaseClass}${googleOAuthUrl ? "" : " cursor-not-allowed opacity-60"}`;

if (apiBase) {
  const cookie = Astro.request.headers.get("cookie") ?? "";
  try {
    const response = await fetch(`${apiBase.replace(/\/$/, "")}/me`, {
      method: "GET",
      headers: cookie ? { cookie } : {},
      credentials: "include",
    });
    if (response.ok) {
      const payload = await response.json().catch(() => null);
      const user = payload?.data ?? payload;
      if (user && user.status && user.status !== "guest") {
        return Astro.redirect(redirectParam);
      }
    }
  } catch (_err) {
    // ignore network errors and render sign-up page
  }
}
---

<Layout title="会員登録 | Logipop" showAuth={false}>
  <section class="relative overflow-hidden bg-gradient-to-br from-background via-background to-primary/10 py-20">
    <div class="container relative z-10 mx-auto grid max-w-5xl gap-10 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:px-8">
      <div class="space-y-6">
        <p class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-background/80 px-3 py-1 text-xs text-muted-foreground">
          <span class="h-2 w-2 rounded-full bg-primary"></span>
          新しいアカウントを作成
        </p>
        <div class="space-y-3">
          <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">会員登録</h1>
          <p class="text-sm text-muted-foreground">
            メールアドレスとパスワードを設定して、学習履歴や添削データを保存しましょう。登録後は確認メールを送信しますので、メールボックスをご確認ください。
          </p>
        </div>
        <div class="rounded-2xl border border-border/60 bg-background/70 p-6 shadow-sm">
          <h2 class="text-sm font-semibold text-foreground">すでにアカウントをお持ちの場合</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            登録済みの方はログインページからサインインしてください。学習データがそのまま引き継がれます。
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition hover:bg-primary/90" href={`/login?redirect=${redirectEncoded}`}>
              ログインページへ
            </a>
            <a class="inline-flex items-center justify-center rounded-md border border-border px-4 py-2 text-sm font-medium text-muted-foreground transition hover:bg-muted" href="/">
              トップに戻る
            </a>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-6 -z-10 rounded-3xl bg-gradient-to-br from-primary/20 via-background to-background blur-3xl" aria-hidden="true"></div>
        <div class="rounded-3xl border border-border/60 bg-background/95 p-8 shadow-2xl">
          <div class="space-y-4">
            <button
              type="button"
              class={googleButtonClass}
              data-google-auth-url={googleOAuthUrl || undefined}
              disabled={!googleOAuthUrl}
            >
              <span class="inline-flex items-center justify-center">
                <img
                  src="/google-icon.svg"
                  alt=""
                  width="18"
                  height="18"
                  class="h-[18px] w-[18px]"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="tracking-tight">Googleで登録</span>
            </button>
            <div class="relative flex items-center">
              <span class="flex-1 border-t border-border"></span>
              <span class="px-3 text-xs text-muted-foreground">またはメールアドレスで登録</span>
              <span class="flex-1 border-t border-border"></span>
            </div>
          </div>
          <form
            id="sign-up-form"
            class="mt-6 space-y-6"
            autocomplete="on"
            data-redirect={redirectEncoded}
          >
            <div class="space-y-1">
              <label for="sign-up-email" class="text-sm font-medium text-foreground">メールアドレス</label>
              <input
                id="sign-up-email"
                name="email"
                type="email"
                required
                placeholder="example@logipo.jp"
                class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
              />
            </div>
            <div class="space-y-1">
              <label for="sign-up-password" class="text-sm font-medium text-foreground">パスワード</label>
              <input
                id="sign-up-password"
                name="password"
                type="password"
                minlength="8"
                required
                class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
              />
            </div>
            <div class="space-y-1">
              <label for="sign-up-password-confirmation" class="text-sm font-medium text-foreground">パスワード（確認）</label>
              <input
                id="sign-up-password-confirmation"
                name="password_confirmation"
                type="password"
                minlength="8"
                required
                class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
              />
            </div>
            <button
              type="submit"
              class="w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground shadow transition hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-60"
            >
              会員登録
            </button>
          </form>
          <div class="mt-4 space-y-2 text-center text-xs text-muted-foreground">
            <p>
              登録後に確認メールが届かない場合は迷惑メールフォルダをご確認ください。24時間以内にリンクの有効期限が切れた場合でも再送できます。
            </p>
            <p>
              まずはゲストとして操作感を知りたい方は
              <a
                href="/app"
                data-link="guest-demo"
                class="font-medium text-primary underline-offset-4 hover:underline"
              >
                ゲストモードで体験
              </a>
              をどうぞ。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<SignUpFormClient client:load />
<GoogleOAuthClient client:load />
